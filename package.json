{
  "name": "pkm-eva",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ui": "playwright test",
    "data:update": "node scripts/update-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "audit:gender": "node scripts/audit-gender.mjs",
    "moves:update": "node scripts/update-moves.mjs && node scripts/update-data.mjs --offline",
    "validate:independent": "node scripts/validate-independent.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
