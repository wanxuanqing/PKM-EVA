{
  "name": "pkm-eva",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "prebuild": "npm run check:dependencies",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ui": "playwright test",
    "data:update": "node scripts/update-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "audit:gender": "node scripts/audit-gender.mjs",
    "moves:update": "node scripts/update-moves.mjs && node scripts/update-data.mjs --offline",
    "validate:independent": "node scripts/validate-independent.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "max:update": "node scripts/update-max.mjs && node scripts/update-max-support.mjs && node scripts/update-data.mjs --offline",
    "max:support:update": "node scripts/update-max-support.mjs && node scripts/update-data.mjs --offline"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "express": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
